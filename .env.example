# Copy this file to .env for local development, then replace every
# change-me value locally. Never commit .env.

POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=thai_data_platform
POSTGRES_PORT=5432
# Used by the local CLI; keep this value in your untracked .env/shell only.
POSTGRES_URL=postgresql://platform:change-me-local-only@127.0.0.1:5432/thai_data_platform

CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me-local-only
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DATABASE=analytics

AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-local-only
# Generate a local Fernet key for Airflow; leave empty only for a throwaway
# local environment. Never commit a generated key.
AIRFLOW_FERNET_KEY=
AIRFLOW_PORT=8080

# Optional future raw landing; unused until the P0 local pipeline is green.
GCS_BUCKET=
GCS_PROJECT_ID=
